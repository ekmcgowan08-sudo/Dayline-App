# Copy to .env for local development. Never commit .env.
# The service role key is a full-access credential — it must only ever
# live on this worker's host/container environment, never in the mobile
# app or any client-side code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tuning (defaults shown)
POLL_INTERVAL_MS=5000
STALE_CLAIM_SECONDS=600
MAX_RETRIES=3
WORKER_ID=
PORT=8080
WORKER_TMP_DIR=/tmp/dayline-worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TITLE_CARD_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Optional: Expo's enhanced push security access token, used when sending
# the "Your Day Is Ready" push (see src/pushNotifications.ts). Not
# required for basic push sending.
EXPO_ACCESS_TOKEN=
