# Copy to .env and fill in real values. Never commit .env.
# All EXPO_PUBLIC_* vars are bundled into the client — never put a secret
# (service role key, provider API keys) in this file's real values.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — RevenueCat platform API keys (public, safe for the client).
# Leave both blank to run entirely on the local mock subscription adapter
# (see docs/DECISIONS.md and src/state/subscription-store.ts).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional — Sentry DSN (public, safe for the client — it's a write-only
# ingest endpoint, not a credential). Leave blank to run crash reporting as
# a real no-op (see docs/DECISIONS.md and src/lib/crashReporting.ts); the
# app still gets a proper in-app error boundary either way, it just won't
# send anything anywhere without this.
EXPO_PUBLIC_SENTRY_DSN=

# Feature flags (default off)
EXPO_PUBLIC_FEATURE_AI_CAPTIONS=false
EXPO_PUBLIC_FEATURE_SOCIAL_LOGIN=false
