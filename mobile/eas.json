{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FEATURE_AI_CAPTIONS": "false",
        "EXPO_PUBLIC_FEATURE_SOCIAL_LOGIN": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_FEATURE_AI_CAPTIONS": "false",
        "EXPO_PUBLIC_FEATURE_SOCIAL_LOGIN": "false"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
