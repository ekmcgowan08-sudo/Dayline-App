# Supabase Edge Function secrets — set these with
# `supabase secrets set --env-file supabase/functions/.env` (never commit
# the real .env). SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform in production; you only need to
# set them yourself for local `supabase functions serve`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# revenuecat-webhook: must match the "Authorization header value" you
# configure in the RevenueCat dashboard's webhook settings.
REVENUECAT_WEBHOOK_SECRET=

# transcribe: 'mock' (default, no external calls) or 'openai'.
TRANSCRIPTION_PROVIDER=mock
OPENAI_API_KEY=

# send-capture-reminders: shared secret the pg_cron job's Authorization
# header must match — generate any long random string.
CRON_SECRET=
# Optional: Expo's enhanced push security access token (dashboard >
# project > credentials). Not required for basic push sending.
EXPO_ACCESS_TOKEN=

# purge-used-clips: how many days a 'used' clip's raw video is kept in
# storage after capture before its storage object is freed (the DB row
# and montage_clips history are kept either way).
RAW_CLIP_RETENTION_DAYS=7
